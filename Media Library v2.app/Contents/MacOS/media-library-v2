#!/bin/bash

# Media Library v2 启动器（macOS .app bundle）
# PySide6 v2：双主题界面 + 高性能分页列表
# 后台静默启动（不弹 Terminal），作为原生 GUI 应用运行

# 日志（排查用）
LOG_FILE="/tmp/media_library_v2_launch.log"
echo "=== Starting Media Library v2 ===" > "$LOG_FILE"
echo "Time: $(date)" >> "$LOG_FILE"

# 程序目录（.app 的上两级即项目根）
PROJECT_DIR="/Users/firewell/bin/media"
echo "程序目录: $PROJECT_DIR" >> "$LOG_FILE"

if [ ! -d "$PROJECT_DIR" ]; then
    echo "错误: 未找到程序目录 $PROJECT_DIR" >> "$LOG_FILE"
    osascript -e 'display alert "启动错误" message "未找到程序目录：'"$PROJECT_DIR"'"' 2>/dev/null
    exit 1
fi

cd "$PROJECT_DIR" || exit 1

# ---------------------------------------------------------------------------
# 选择 Python：Spotlight 启动 .app 时不会加载用户 shell 配置（.zshrc），
# PATH 里的 python3 可能解析到 Xcode 自带的残缺 Python（缺 PySide6/numpy，
# 或架构不匹配导致崩溃）。
#
# 策略：按优先级探测多个 Python 路径，找到第一个同时能 import
# PySide6 + numpy + cv2 的（这三个是 v2 启动必需的）。
# 顺序：anaconda（用户主装了依赖的）→ homebrew → 系统 → Xcode（兜底）
# ---------------------------------------------------------------------------
PYTHON_CMD=""
PYTHON_CANDIDATES=(
    "$HOME/anaconda3/bin/python3"
    "$HOME/miniconda3/bin/python3"
    "/opt/homebrew/bin/python3"
    "/usr/local/bin/python3"
    "/usr/bin/python3"
    "python3"
    "python"
)

for py in "${PYTHON_CANDIDATES[@]}"; do
    if [ -x "$py" ] || command -v "$py" &> /dev/null; then
        # 验证：能 import 三个核心依赖
        if "$py" -c "import PySide6, numpy, cv2" 2>/dev/null; then
            PYTHON_CMD="$py"
            echo "选中 Python: $PYTHON_CMD ($($py --version 2>&1))" >> "$LOG_FILE"
            break
        else
            echo "跳过 $py（缺依赖）" >> "$LOG_FILE"
        fi
    fi
done

# 没找到完整环境的 python：用 PATH 第一个，并尝试装依赖
if [ -z "$PYTHON_CMD" ]; then
    if command -v python3 &> /dev/null; then
        PYTHON_CMD="python3"
    elif command -v python &> /dev/null; then
        PYTHON_CMD="python"
    else
        echo "错误: 未找到任何 python" >> "$LOG_FILE"
        osascript -e 'display alert "启动错误" message "未找到 Python，请先安装 Python 3.9+ 并配置 PySide6/numpy/opencv-python。"' 2>/dev/null
        exit 1
    fi
    echo "未找到完整环境，用 $PYTHON_CMD 并尝试安装依赖..." >> "$LOG_FILE"
    "$PYTHON_CMD" -m pip install --user PySide6 numpy opencv-python \
        -i https://pypi.tuna.tsinghua.edu.cn/simple >> "$LOG_FILE" 2>&1
fi

# 检查主程序文件
if [ ! -f "media_library_v2.py" ]; then
    echo "错误: 未找到 media_library_v2.py" >> "$LOG_FILE"
    osascript -e 'display alert "启动错误" message "未找到 media_library_v2.py 文件。"' 2>/dev/null
    exit 1
fi

# 后台静默启动（nohup + disown，不弹 Terminal，应用退出后启动器自动退出）
echo "正在启动 Media Library v2..." >> "$LOG_FILE"
nohup "$PYTHON_CMD" media_library_v2.py >> "$LOG_FILE" 2>&1 &
APP_PID=$!
disown $APP_PID
echo "已启动，PID: $APP_PID" >> "$LOG_FILE"

# 启动器立即退出（GUI 进程已 detach）
exit 0
