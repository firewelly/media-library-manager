erDiagram
    videos {
        int id PK
        text file_name
        text file_path
        int file_size
        text title
        text actors
        int stars
        text tags
        text duration
        text resolution
        text year
        int is_nas_online
        text source_folder
        text file_created_time
        text md5_hash
        text file_hash
        text created_at
    }
    actors {
        int id PK
        text name UK
        text avatar_path
        text info_url
        text created_at
        text updated_at
    }
    video_actors {
        int video_id FK
        int actor_id FK
        int actor_id_unique
        text actor_name
    }
    javdb_info {
        int id PK
        int video_id FK
        text javdb_code
        text javdb_title
        text javdb_description
        real javdb_rating
        text javdb_cover_url
        text release_date
        text updated_at
    }
    javdb_tags {
        int id PK
        text tag_name UK
    }
    javdb_info_tags {
        int javdb_info_id FK
        int tag_id FK
    }
    folders {
        int id PK
        text path
        int is_enabled
    }

    videos ||--o{ video_actors : "has actors"
    actors ||--o{ video_actors : "appears in"
    videos ||--o| javdb_info : "has metadata"
    javdb_info ||--o{ javdb_info_tags : "has tags"
    javdb_tags ||--o{ javdb_info_tags : "linked to"
